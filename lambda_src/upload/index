import { S3Client, PutObjectCommand } from "@aws-sdk/client-s3";
import { randomUUID } from "crypto";
import Busboy from "busboy";

const s3 = new S3Client({ region: process.env.AWS_REGION ?? "us-east-1" });

const BUCKET      = process.env.S3_BUCKET;
const PREFIX      = process.env.UPLOAD_PREFIX ?? "uploads/";
const MAX_SIZE    = 10 * 1024 * 1024; // 10 MB
const ALLOWED_MIME = new Set(["image/jpeg", "image/png", "image/gif", "image/webp"]);
const EXT_MAP     = {
  "image/jpeg": "jpg",
  "image/png":  "png",
  "image/gif":  "gif",
  "image/webp": "webp",
};

export const handler = async (event) => {
  try {
    const contentType = event.headers?.["content-type"] ?? "";

    // ── Multipart/form-data ────────────────────────────────
    if (contentType.includes("multipart/form-data")) {
      return await handleMultipart(event);
    }

    // ── JSON + base64 ──────────────────────────────────────
    if (contentType.includes("application/json")) {
      return await handleJsonBase64(event);
    }

    return response(415, { error: "Content-Type no soportado. Use multipart/form-data o application/json con base64." });

  } catch (err) {
    console.error("Error en upload handler:", err);
    return response(500, { error: "Error interno al procesar la imagen." });
  }
};

// ── Multipart parser ───────────────────────────────────────
async function handleMultipart(event) {
  return new Promise((resolve, reject) => {
    const busboy = Busboy({
      headers: { "content-type": event.headers["content-type"] },
      limits: { fileSize: MAX_SIZE },
    });

    let fileBuffer = null;
    let mimeType   = null;
    let fileName   = null;
    let sizeExceeded = false;

    busboy.on("file", (_field, file, info) => {
      mimeType = info.mimeType;
      fileName = info.filename;
      const chunks = [];

      file.on("data", (chunk) => chunks.push(chunk));
      file.on("limit", () => { sizeExceeded = true; });
      file.on("close", () => {
        if (!sizeExceeded) fileBuffer = Buffer.concat(chunks);
      });
    });

    busboy.on("finish", async () => {
      if (sizeExceeded) {
        return resolve(response(413, { error: "Archivo excede el límite de 10MB." }));
      }
      if (!fileBuffer) {
        return resolve(response(400, { error: "No se encontró ningún archivo en el formulario." }));
      }
      const result = await uploadToS3(fileBuffer, mimeType);
      resolve(result);
    });

    busboy.on("error", (err) => reject(err));

    const body = event.isBase64Encoded
      ? Buffer.from(event.body, "base64")
      : Buffer.from(event.body);

    busboy.write(body);
    busboy.end();
  });
}

// ── JSON + Base64 parser ──────────────────────────────────
async function handleJsonBase64(event) {
  const body = JSON.parse(event.body);
  const { data, mimeType } = body;

  if (!data || !mimeType) {
    return response(400, { error: "Se requieren los campos 'data' (base64) y 'mimeType'." });
  }

  const buffer = Buffer.from(data, "base64");

  if (buffer.byteLength > MAX_SIZE) {
    return response(413, { error: "Archivo excede el límite de 10MB." });
  }

  return await uploadToS3(buffer, mimeType);
}

// ── Subida a S3 ───────────────────────────────────────────
async function uploadToS3(buffer, mimeType) {
  if (!ALLOWED_MIME.has(mimeType)) {
    return response(400, {
      error: `Tipo de archivo no permitido: ${mimeType}. Permitidos: jpg, png, gif, webp.`,
    });
  }

  const ext = EXT_MAP[mimeType];
  const key = `${PREFIX}${randomUUID()}.${ext}`;

  await s3.send(new PutObjectCommand({
    Bucket:      BUCKET,
    Key:         key,
    Body:        buffer,
    ContentType: mimeType,
    // SSE heredado de la configuración del bucket (AES-256)
  }));

  console.log(`Imagen subida exitosamente: ${key}`);

  return response(200, {
    message: "Imagen subida correctamente.",
    key,
    bucket: BUCKET,
  });
}

// ── Helper ────────────────────────────────────────────────
function response(statusCode, body) {
  return {
    statusCode,
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  };
}
